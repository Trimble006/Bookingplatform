generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-Tenant ────────────────────────────────────────────

// Tenant lifecycle states. `active` boolean is retained as a denormalised
// mirror (`active = status == ACTIVE`) so existing call sites keep working
// during the migration; new code should read `status` directly.
enum TenantStatus {
  LEAD // application received, no tenant created yet (placeholder; rarely used since approval creates ONBOARDING)
  ONBOARDING // approved, admin invited, pre-go-live
  ACTIVE // live and operational
  SUSPENDED // disabled by platform (non-payment, abuse, manual)
  CHURNED // permanently inactive; soft-deleted
}

// Tenant country / jurisdiction. PLATFORM_ADMIN-only to set; tenants cannot
// self-elect into a regulatory regime. Drives gating for jurisdiction-coupled
// features (charity accounts, future Gift Aid, VAT/MTD, etc.). Add new
// values only as features that need them land — never speculatively.
// See decisions log 2026-05-03 (Tenant.country jurisdiction hook).
enum Country {
  GB // Great Britain (England, Scotland, Wales)
  NI // Northern Ireland
  OTHER // anywhere else (default for existing rows; jurisdiction-coupled features unavailable)
}

// Organisation type captured during onboarding (KYC). Used for advice in
// the wizard, gating of charity-style features (in conjunction with country),
// and future per-form analytics. UK-focused taxonomy in v1; extend with
// region-specific values as we open up other markets. See decisions log
// 2026-05-04 (org type taxonomy choice).
enum OrganisationType {
  REGISTERED_CHARITY // CC E&W or CCNI registered charity
  CIO // Charitable Incorporated Organisation (England & Wales)
  SCIO // Scottish Charitable Incorporated Organisation
  CASC // Community Amateur Sports Club
  COMMUNITY_INTEREST_COMPANY // CIC
  LIMITED_COMPANY // Companies House registered, non-charitable
  UNINCORPORATED_ASSOCIATION // most common starting form; trustees personally liable
  PRIVATE_MEMBERS_CLUB // non-charitable members' club
  OTHER
  NOT_CONSTITUTED // hasn't formed any legal entity yet
}

model Tenant {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  status                TenantStatus      @default(ACTIVE)
  active                Boolean           @default(true) // DEPRECATED: mirror of (status == ACTIVE); kept for back-compat
  country               Country           @default(OTHER) // jurisdiction; settable in onboarding (self-declared) or by PLATFORM_ADMIN. Gates charity & future jurisdiction-coupled features. See decisions log 2026-05-04 (country self-election reversal).
  organisationType      OrganisationType? // KYC: set in onboarding chapter 2. NULL for tenants onboarded before this field existed.
  // Default financial year end (month/day). Used as default for CharitySettings
  // year-end and reusable for any future reporting period (membership year,
  // billing alignment, analytics). NULL until set in onboarding.
  financialYearEndMonth Int? // 1..12
  financialYearEndDay   Int? // 1..31
  brandColor            String            @default("#16a34a")
  logoUrl               String?
  locale                String            @default("en")
  seasonStart           String? // DEPRECATED: migrated to Green.seasonStartMMDD. Remove after one release.
  seasonEnd             String? // DEPRECATED: migrated to Green.seasonEndMMDD. Remove after one release.
  openingTime           String            @default("08:00")
  closingTime           String            @default("20:00")
  latitude              Float?
  longitude             Float?
  locality              String? // Human-readable town/city. Disambiguates clubs sharing a display name. Set in onboarding (Chapter 2b) or settings.
  goLiveAt              DateTime? // set when the admin presses 'Go live' at the end of the onboarding wizard. NULL while ONBOARDING.
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  users              User[]
  memberships        Membership[]
  invitations        UserInvitation[]
  application        TenantApplication?
  greens             Green[]
  bookings           Booking[]
  featureFlags       FeatureFlag[]
  tenantPayments     TenantPayment[]
  tasks              MaintenanceTask[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  contentSections    ContentSection[]
  events             Event[]
  channels           Channel[]
  messages           Message[]
  trackingEvents     TrackingEvent[]
  impersonations     Impersonation[]
  subscription       TenantSubscription?
  streamSessions     StreamSession[]
  streamTokens       StreamToken[]
  helpOverrides      HelpArticleOverride[]
  outboundMessages   OutboundMessage[]
  onboardingProgress OnboardingProgress?

  // Billing
  billingProfile TenantBillingProfile?

  // Agent system
  agentRuns          AgentRun[]
  agentDecisions     AgentDecision[]
  agentMemories      AgentMemory[]
  agentConfigs       AgentConfig[]
  agentKnowledge     AgentKnowledge[]
  agentMetrics       AgentConfidenceMetrics[]
  agentProposals     AgentProposal[]
  agentBudget        TenantAgentBudget?
  maintenanceHistory MaintenanceHistory[]
  sentimentSnapshots SentimentSnapshot[]

  // Charity Accounts (UK/NI; gated by country + `charity` feature flag)
  charitySettings         CharitySettings?
  charityFinancialYears   CharityFinancialYear[]
  charityCategories       CharityCategory[]
  charityFunds            CharityFund[]
  charityTransactions     CharityTransaction[]
  charityAssetLiabilities CharityAssetLiability[]
  charityTARs             CharityTAR[]
}

// ─── Auth & RBAC ─────────────────────────────────────────────

enum Role {
  GUEST
  USER
  MAINTENANCE
  TENANT_ADMIN
  PLATFORM_ADMIN
}

// User is now a global identity. A user can hold zero or more `Membership`
// rows linking them to tenants with role+kind. The legacy `tenantId` and
// `role` fields are denormalised mirrors of the user's primary membership
// (lowest membership.createdAt) and are kept for back-compat — new code
// should read from `Membership` directly.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String // nullable-in-spirit: invited users get a placeholder hash that cannot match any password
  isPlatformAdmin Boolean  @default(false)
  role            Role     @default(USER) // DEPRECATED: mirror of primary membership role; kept for back-compat
  suspended       Boolean  @default(false)
  profession      String? // travels with the person, not the club (e.g. "Professional Greenkeeper")
  qualifications  String? // free-text or JSON; expanded later
  specialisms     String? // free-text; feeds future PROFESSIONAL agent-knowledge scope
  tenantId        String? // DEPRECATED: mirror of primary membership tenantId
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  sentInvitations UserInvitation[] @relation("InvitationsSent")

  bookings             Booking[]
  bookingsCreated      Booking[]             @relation("BookingsCreatedBy")
  assignedTasks        MaintenanceTask[]     @relation("AssignedTo")
  submittedTasks       MaintenanceTask[]     @relation("SubmittedBy")
  taskNotes            TaskNote[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  auditEvents          AuditEvent[]
  createdSections      ContentSection[]      @relation("CreatedBy")
  updatedSections      ContentSection[]      @relation("UpdatedBy")
  createdEvents        Event[]               @relation("EventCreatedBy")
  updatedEvents        Event[]               @relation("EventUpdatedBy")
  createdHelpOverrides HelpArticleOverride[] @relation("HelpOverrideCreatedBy")
  updatedHelpOverrides HelpArticleOverride[] @relation("HelpOverrideUpdatedBy")
  channelMemberships   ChannelMember[]
  messages             Message[]
  createdChannels      Channel[]             @relation("ChannelCreatedBy")
  trackingEvents       TrackingEvent[]
  impersonations       Impersonation[]
  createdStreams       StreamSession[]       @relation("StreamCreatedBy")
  streamViewers        StreamViewer[]        @relation("StreamViewers")
  createdTokens        StreamToken[]         @relation("TokenCreatedBy")

  // Agent system
  agentDefinition           AgentDefinition?
  agentFeedback             AgentFeedback[]
  agentKnowledgeAuthor      AgentKnowledge[]     @relation("KnowledgeCreatedBy")
  maintenanceHistoryEntries MaintenanceHistory[] @relation("HistoryPerformedBy")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Feature Flags ───────────────────────────────────────────

model FeatureFlag {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  key      String
  enabled  Boolean @default(false)

  @@unique([tenantId, key])
}

// ─── Greens & Rinks ─────────────────────────────────────────

model Green {
  id                 String               @id @default(cuid())
  name               String
  tenantId           String
  allWeather         Boolean              @default(false)
  seasonStartMMDD    String? // recurring month-day e.g. "04-01"
  seasonEndMMDD      String? // recurring month-day e.g. "09-30"
  maintenanceHistory MaintenanceHistory[] @relation("GreenHistory")
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  rinks              Rink[]
  seasons            GreenSeason[]
}

model GreenSeason {
  id        String   @id @default(cuid())
  greenId   String
  year      Int
  startDate String // full ISO date e.g. "2027-03-01"
  endDate   String // full ISO date e.g. "2027-09-30"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  green Green @relation(fields: [greenId], references: [id], onDelete: Cascade)

  @@unique([greenId, year])
}

model Rink {
  id      String @id @default(cuid())
  name    String
  greenId String
  green   Green  @relation(fields: [greenId], references: [id])

  bookingSlots   BookingSlot[]
  streamSessions StreamSession[]
}

// ─── Live Streaming ──────────────────────────────────────────

enum StreamingTier {
  NONE
  BRONZE
  SILVER
  GOLD
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum StreamStatus {
  IDLE
  LIVE
  ENDED
  ARCHIVED
}

enum StreamVisibility {
  MEMBERS_ONLY
  PUBLIC
}

enum StreamAccessMethod {
  AUTHENTICATED
  TOKEN_LINK
}

model TenantSubscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  tier                 StreamingTier      @default(NONE)
  maxConcurrentStreams Int                @default(0)
  archiveRetentionDays Int                @default(0)
  priceMonthlyPence    Int                @default(0)
  status               SubscriptionStatus @default(ACTIVE)
  activeSince          DateTime           @default(now())
  expiresAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model StreamSession {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  rinkId       String
  rink         Rink             @relation(fields: [rinkId], references: [id])
  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id])
  title        String
  status       StreamStatus     @default(IDLE)
  visibility   StreamVisibility @default(MEMBERS_ONLY)
  streamKey    String           @unique @default(cuid())
  archiveUrl   String?
  thumbnailUrl String?
  createdById  String
  createdBy    User             @relation("StreamCreatedBy", fields: [createdById], references: [id])
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  viewers StreamViewer[]
  tokens  StreamToken[]

  @@index([tenantId, status])
  @@index([rinkId, status])
}

model StreamViewer {
  id                 String             @id @default(cuid())
  streamSessionId    String
  streamSession      StreamSession      @relation(fields: [streamSessionId], references: [id])
  userId             String?
  user               User?              @relation("StreamViewers", fields: [userId], references: [id])
  sessionFingerprint String
  accessMethod       StreamAccessMethod @default(AUTHENTICATED)
  tokenId            String?
  joinedAt           DateTime           @default(now())
  leftAt             DateTime?
  durationSeconds    Int?

  @@index([streamSessionId, joinedAt])
  @@index([userId])
}

model StreamToken {
  id              String        @id @default(cuid())
  streamSessionId String
  streamSession   StreamSession @relation(fields: [streamSessionId], references: [id])
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  token           String        @unique @default(cuid())
  expiresAt       DateTime
  maxUses         Int?
  useCount        Int           @default(0)
  createdById     String
  createdBy       User          @relation("TokenCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([token])
}

// ─── Booking ─────────────────────────────────────────────────

enum BookingStatus {
  REQUESTED
  APPROVED
  RESERVED
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  bookedByUserId String?
  bookedByUser   User?         @relation("BookingsCreatedBy", fields: [bookedByUserId], references: [id])
  date           String // ISO date "2026-05-10"
  status         BookingStatus @default(REQUESTED)
  adminOverride  Boolean       @default(false)
  overrideReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  slots           BookingSlot[]
  waitlistEntries WaitlistEntry[]
  payment         BookingPayment?

  @@index([bookedByUserId])
}

model BookingSlot {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id])
  rinkId     String
  rink       Rink    @relation(fields: [rinkId], references: [id])
  timeSlot   String // e.g. "10:00-12:00"
  playerName String?
  greenName  String? // Cached green name at time of booking
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// ─── Payments & Billing ──────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Type of charge on a TenantPayment row.
enum PaymentType {
  SUBSCRIPTION // monthly platform plan fee
  STREAMING    // streaming tier addon
  ADDON        // other paid extras
  CREDIT       // credit note / refund adjustment
  ADJUSTMENT   // manual correction by platform admin
}

// How the tenant intends to pay. INVOICE is the only real option in v1;
// DIRECT_DEBIT and CARD are reserved for Stripe phase.
enum BillingPaymentMethod {
  INVOICE
  DIRECT_DEBIT
  CARD
}

// Billing profile lifecycle.
enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// Category for a single line item on an invoice.
enum InvoiceLineCategory {
  PLATFORM_SUBSCRIPTION
  STREAMING_TIER
  BOOKING_COMMISSION
  ADDON
  CREDIT
}

// Platform pricing plans. Seeded with Starter / Standard / Premium.
model PlatformPlan {
  id                    String        @id @default(cuid())
  name                  String // e.g. "Starter", "Standard", "Premium"
  slug                  String        @unique // url-safe identifier
  description           String?
  priceMonthlyPence     Int // e.g. 2500 = £25
  trialDays             Int           @default(30)
  maxMembers            Int           @default(50)
  maxGreens             Int           @default(2)
  includedStreamingTier StreamingTier @default(NONE)
  featureFlags          Json?         @default("{}")
  sortOrder             Int           @default(0)
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  billingProfiles TenantBillingProfile[]
}

// Per-tenant billing profile. One-to-one with Tenant.
model TenantBillingProfile {
  id                  String               @id @default(cuid())
  tenantId            String               @unique
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  planId              String
  plan                PlatformPlan         @relation(fields: [planId], references: [id])
  billingContactName  String?
  billingContactEmail String?
  billingAddress      Json?                @default("{}")
  vatNumber           String?
  paymentMethod       BillingPaymentMethod @default(INVOICE)
  billingStatus       BillingStatus        @default(TRIAL)
  currentPeriodStart  DateTime             @default(now())
  currentPeriodEnd    DateTime
  trialEndsAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  payments TenantPayment[]
}

model BookingPayment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  amount      Int // in pence/cents
  currency    String        @default("GBP")
  status      PaymentStatus @default(PENDING)
  checkoutUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TenantPayment {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  billingProfileId String?
  billingProfile   TenantBillingProfile? @relation(fields: [billingProfileId], references: [id])
  amount           Int
  currency         String                @default("GBP")
  status           PaymentStatus         @default(PENDING)
  type             PaymentType           @default(SUBSCRIPTION)
  invoiceRef       String?
  periodStart      DateTime?
  periodEnd        DateTime?
  pdfUrl           String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  lineItems InvoiceLineItem[]

  @@index([tenantId, status])
  @@index([billingProfileId])
}

// Individual line items making up an invoice (TenantPayment).
model InvoiceLineItem {
  id              String              @id @default(cuid())
  paymentId       String
  payment         TenantPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int                 @default(1)
  unitPricePence  Int
  totalPricePence Int
  category        InvoiceLineCategory
  sortOrder       Int                 @default(0)
}

// ─── Maintenance ─────────────────────────────────────────────

enum TaskCategory {
  GENERAL
  RINK_SURFACE
  EQUIPMENT
  FACILITIES
  SAFETY
  GROUNDS
  PREVENTIVE // proactive tasks suggested by an agent (no complaint received)
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  CLOSED
  REOPENED
}

// Who can see a maintenance task. Member-derived tasks (created by an
// agent from messaging content) default to MAINTENANCE_ONLY to avoid
// surprising members with their own words echoed back as visible tasks.
// Promotion to MEMBERS / PUBLIC requires an explicit MAINTENANCE+ action.
// See decisions log 2026-05-03 (member-message-derived tasks).
enum TaskVisibility {
  MAINTENANCE_ONLY // default for agent-derived; visible to MAINTENANCE+ only
  MEMBERS // visible to all club members (existing default behaviour)
  PUBLIC // visible on the public site (rare; e.g. "course closed")
}

model MaintenanceTask {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  title         String
  description   String
  category      TaskCategory   @default(GENERAL)
  priority      TaskPriority   @default(MEDIUM)
  status        TaskStatus     @default(SUBMITTED)
  // Visibility default is MAINTENANCE_ONLY for newly-created rows. Existing
  // rows backfill to MEMBERS in migration 20260503_add_task_visibility to
  // preserve current behaviour. Tasks created via the human form
  // (POST /api/maintenance) explicitly set MEMBERS so behaviour is unchanged
  // for human-submitted tasks; agent-emitted tasks omit the field and get
  // MAINTENANCE_ONLY from the column default.
  visibility    TaskVisibility @default(MAINTENANCE_ONLY)
  submittedById String
  submittedBy   User           @relation("SubmittedBy", fields: [submittedById], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  notes             TaskNote[]
  agentInteractions TaskAgentInteraction[]

  @@index([tenantId, visibility, status])
}

model TaskNote {
  id        String          @id @default(cuid())
  taskId    String
  task      MaintenanceTask @relation(fields: [taskId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime        @default(now())
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // e.g. "WAITLIST_AVAILABLE", "TASK_ASSIGNED", "BOOKING_APPROVED"
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Audit Trail ─────────────────────────────────────────────

model AuditEvent {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  tenantId         String?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])
  actorId          String
  actor            User     @relation(fields: [actorId], references: [id])
  actorRole        Role
  // When set, the action was performed by `actor` (a PLATFORM_ADMIN) while
  // impersonating a tenant context. `actingAsTenantId` is the impersonated tenant
  // and `actingAsRole` is the role the platform admin assumed (typically TENANT_ADMIN).
  actingAsTenantId String?
  actingAsRole     Role?
  impersonationId  String?
  action           String // dot-notation e.g. "booking.created"
  entity           String // model name e.g. "Booking"
  entityId         String?
  piiAccess        Boolean  @default(false)
  meta             String? // JSON string for flexible payload

  @@index([tenantId, timestamp])
  @@index([actorId, timestamp])
  @@index([entity, entityId])
  @@index([impersonationId])
}

// ─── Platform Admin Impersonation ────────────────────────────

/// Records a platform admin assuming a tenant role to act on behalf of a club.
/// Created when impersonation starts; `endedAt` set when explicitly exited.
model Impersonation {
  id             String    @id @default(cuid())
  platformUserId String
  platformUser   User      @relation(fields: [platformUserId], references: [id])
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  assumedRole    Role      @default(TENANT_ADMIN)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  reason         String?

  @@index([platformUserId, startedAt])
  @@index([tenantId, startedAt])
}

// ─── Content Management ──────────────────────────────────────

enum SectionType {
  HERO
  ABOUT
  PHOTO
  MAP
  CONTACT
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model ContentSection {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  type        SectionType
  status      ContentStatus @default(DRAFT)
  enabled     Boolean       @default(true)
  order       Int           @default(0)
  title       String
  content     String // JSON blob — shape varies by section type
  createdById String
  createdBy   User          @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?         @relation("UpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, status])
}

// ─── Events ──────────────────────────────────────────────────

enum EventCategory {
  SOCIAL
  COMPETITION
  LEAGUE
  OPEN_DAY
  TOURNAMENT
  OTHER
}

enum EventFormat {
  KNOCKOUT
  AMERICAN
  LEAGUE_FORMAT
  CANADIAN
  OTHER_FORMAT
}

enum PlayerCount {
  SINGLES
  PAIRS
  TRIPLES
  FOURS
}

enum EventVisibility {
  MEMBERS_ONLY
  PUBLIC
}

model Event {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  title        String
  description  String
  category     EventCategory   @default(SOCIAL)
  format       EventFormat?
  playerCount  PlayerCount?
  date         String // ISO date "2026-06-15"
  startTime    String // "HH:mm"
  endTime      String?
  location     String?
  capacity     Int?
  entryFee     Int? // in pence
  currency     String          @default("GBP")
  imageUrl     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  visibility   EventVisibility @default(MEMBERS_ONLY)
  status       String          @default("DRAFT") // DRAFT | PUBLISHED
  createdById  String
  createdBy    User            @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?           @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  streamSessions StreamSession[]

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([visibility, status])
}

// ─── Messaging ───────────────────────────────────────────────

enum ChannelType {
  PUBLIC
  PRIVATE
  GROUP
  DIRECT
}

enum ChannelMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Channel {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  type        ChannelType @default(PUBLIC)
  createdById String
  createdBy   User        @relation("ChannelCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members     ChannelMember[]
  messages    Message[]
  readCursors MessageReadCursor[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
}

model ChannelMember {
  id         String            @id @default(cuid())
  channelId  String
  channel    Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  role       ChannelMemberRole @default(MEMBER)
  mutedUntil DateTime?
  joinedAt   DateTime          @default(now())

  @@unique([channelId, userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String
  pinned    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([channelId, createdAt])
  @@index([tenantId, createdAt])
}

model MessageReadCursor {
  id                String   @id @default(cuid())
  channelId         String
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId            String
  lastReadMessageId String
  updatedAt         DateTime @updatedAt

  @@unique([channelId, userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Feature Tracking (Observability) ────────────────────────

enum TrackingEventType {
  PAGE_VIEW
  FEATURE_USE
  INTERACTION
  SESSION_START
}

model TrackingEvent {
  id                 String            @id @default(cuid())
  timestamp          DateTime          @default(now())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])
  sessionFingerprint String
  eventType          TrackingEventType
  path               String
  action             String?
  entity             String?
  entityId           String?
  browserFamily      String
  browserVersion     String?
  osFamily           String
  deviceType         String
  isPWA              Boolean           @default(false)
  meta               String?

  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@index([path, timestamp])
  @@index([sessionFingerprint])
}

// ─── Help Centre ─────────────────────────────────────────────

/// Optional per-tenant override for a shipped help article.
/// Composite uniqueness on (tenantId, slug, locale): each tenant may override
/// each article in each locale at most once. Setting `enabled=false` hides the
/// shipped article for that tenant + locale; otherwise the override's `title`
/// and `body` replace the shipped values.
model HelpArticleOverride {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  slug        String
  locale      String
  enabled     Boolean  @default(true)
  title       String?
  body        String? // markdown
  createdById String
  createdBy   User     @relation("HelpOverrideCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("HelpOverrideUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug, locale])
  @@index([tenantId, slug])
}

// ─── Maintenance History ─────────────────────────────────────
//
// Clubs log past activities (spiked, scarified, herbicide etc.) so the agents
// can reason with context — e.g. don't escalate moss 3 days after herbicide.

enum MaintenanceActivityType {
  SPIKED
  SCARIFIED
  OVERSEEDED
  FERTILISED
  HERBICIDE_APPLIED
  TOP_DRESSED
  MOWED
  WATERED
  DRAINED
  OTHER
}

model MaintenanceHistory {
  id            String                  @id @default(cuid())
  tenantId      String
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  greenId       String?
  green         Green?                  @relation("GreenHistory", fields: [greenId], references: [id])
  activityType  MaintenanceActivityType
  description   String?
  performedAt   DateTime
  performedById String?
  performedBy   User?                   @relation("HistoryPerformedBy", fields: [performedById], references: [id])
  notes         String?
  createdAt     DateTime                @default(now())

  @@index([tenantId, performedAt])
  @@index([greenId, performedAt])
}

// ─── Agent Framework ─────────────────────────────────────────
//
// Multi-agent system. Each AgentDefinition is a globally-registered agent
// (e.g. "detector", "triager"). Per-tenant config + memory + decisions live
// in side tables. Two-level feedback (validity + priority + assignment) is
// captured against each decision.

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  RATE_LIMITED
}

// DEPRECATED: maintenance-shaped action enum from the v1 agent framework.
// New agents emit AgentProposal rows with a free-text `kind` instead.
// Kept on AgentDecision for back-compat with existing detector/triager runs;
// drop one release after step 3 (detector/triager migration to AgentProposal).
enum AgentAction {
  CREATED_TASK
  ESCALATED_TASK
  PRIORITY_CHANGED
  ASSIGNED_TASK
  CONTEXT_ADDED
  PREDICTED_TASK
  NO_ACTION
}

// Scope of an agent — see /memories/repo/decisions-log.md and the agent
// strategy plan. Determines the entry point (runForTenant / runForPlatform /
// runForUser / runForFederation) and the audience of emitted proposals.
enum AgentScope {
  TENANT // per-tenant; reads + writes one tenant
  PLATFORM // cross-tenant; platform-admin reviews
  USER // cross-tenant per a single user (e.g. greenkeeper for many clubs)
  FEDERATION // reserved for Phase 10; no FK until federation models exist
}

// Whether the agent's logic depends on a generative LLM call.
// Used by cost dashboards to highlight cosmetic LLM spend.
enum AgentLlmUsage {
  ALWAYS // generative model is core to the agent (drafting, vision, open-class)
  SUMMARY_ONLY // deterministic logic with optional LLM prose summary
  NEVER // pure rules / arithmetic; no model calls
}

// Audience that reviews a proposal. Different from the agent's scope:
// e.g. a USER-scope agent can emit TENANT-audience proposals if appropriate,
// though typically scope and audience match.
enum AgentProposalAudience {
  TENANT
  PLATFORM
  USER
  FEDERATION
}

// Lifecycle of an AgentProposal.
enum AgentProposalStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  EXPIRED
}

// How a run was triggered.
enum AgentRunMode {
  SCHEDULED
  MANUAL
  TRIGGERED
}

enum InteractionType {
  CREATED
  PRIORITY_CHANGED
  CONTEXT_ADDED
  ASSIGNED
  ESCALATED
}

enum ValidityFeedback {
  CORRECT
  INCORRECT
}

enum PriorityFeedback {
  CORRECT
  TOO_HIGH
  TOO_LOW
}

enum AssignmentFeedback {
  CORRECT
  WRONG_PERSON
}

enum KnowledgeScope {
  GLOBAL
  REGIONAL
  TENANT
}

enum KnowledgeSource {
  SEEDED
  MANUAL
  LEARNED
}

enum SentimentTrend {
  IMPROVING
  STABLE
  DECLINING
}

model AgentDefinition {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String?
  systemUserId   String        @unique
  systemUser     User          @relation(fields: [systemUserId], references: [id])
  enabled        Boolean       @default(true)
  // Strategic fields — see agent strategy plan §B/§H/§L.
  // Defaulted to TENANT/ALWAYS for back-compat with existing detector/triager;
  // new agents must set these explicitly.
  scope          AgentScope    @default(TENANT)
  usesLLM        AgentLlmUsage @default(ALWAYS)
  // Optional per-agent model preference (overrides env tier mapping).
  // Null = use the env-configured model for the requested tier.
  preferredModel String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  runs      AgentRun[]
  decisions AgentDecision[]
  memories  AgentMemory[]
  configs   AgentConfig[]
  knowledge AgentKnowledge[]
  metrics   AgentConfidenceMetrics[]
  proposals AgentProposal[]
}

model AgentRun {
  id           String          @id @default(cuid())
  agentId      String
  agent        AgentDefinition @relation(fields: [agentId], references: [id])
  // Nullable from v2: PLATFORM/USER-scope runs may have no single tenant.
  tenantId     String?
  tenant       Tenant?         @relation(fields: [tenantId], references: [id])
  // Run-time copy of the agent's scope; lets us reason about runs without joining.
  scope        AgentScope      @default(TENANT)
  // For USER-scope runs.
  userId       String?
  // For FEDERATION-scope runs (no FK until federation table exists).
  federationId String?
  // How this run was triggered.
  mode         AgentRunMode    @default(SCHEDULED)
  status       AgentRunStatus  @default(RUNNING)
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  summary      String? // JSON blob: { messagesProcessed, tasksCreated, ... }
  error        String?

  // Cost + provider observability (populated by provider wrapper).
  // costsCents is platform-attributable spend in pennies; 0 for local providers.
  costsCents Int     @default(0)
  tokensIn   Int     @default(0)
  tokensOut  Int     @default(0)
  provider   String? // e.g. "ollama", "gemini", "anthropic", "stub"
  model      String? // e.g. "qwen2.5:3b", "gemini-flash-1.5", "stub"
  traceJson  String? // optional structured trace (model calls, latencies, cache hits)

  decisions AgentDecision[]
  proposals AgentProposal[]

  @@index([tenantId, startedAt])
  @@index([agentId, startedAt])
  @@index([userId, startedAt])
}

model AgentDecision {
  id         String          @id @default(cuid())
  agentId    String
  agent      AgentDefinition @relation(fields: [agentId], references: [id])
  runId      String
  run        AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Nullable from v2 to match AgentRun.tenantId becoming nullable.
  tenantId   String?
  tenant     Tenant?         @relation(fields: [tenantId], references: [id])
  // DEPRECATED in v2 — kept populated for back-compat by detector/triager;
  // new agents leave this NO_ACTION and reference the proposal instead.
  action     AgentAction
  confidence Float
  reasoning  String

  // v2: link to the proposal this decision produced (if any).
  proposalId String?
  proposal   AgentProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  // DEPRECATED structured fields — payload moves into AgentProposal.payload.
  // Kept for back-compat; drop one release after detector/triager migration.
  sourceMessageId  String?
  taskId           String?
  previousPriority TaskPriority?
  newPriority      TaskPriority?
  assignedToId     String?
  contextAdded     String?

  createdAt DateTime @default(now())

  feedback     AgentFeedback?
  interactions TaskAgentInteraction[]

  @@index([tenantId, createdAt])
  @@index([agentId, createdAt])
  @@index([taskId])
  @@index([sourceMessageId])
  @@index([proposalId])
}

model AgentFeedback {
  id                 String              @id @default(cuid())
  decisionId         String              @unique
  decision           AgentDecision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  validityFeedback   ValidityFeedback?
  priorityFeedback   PriorityFeedback?
  assignmentFeedback AssignmentFeedback?
  note               String?
  givenById          String
  givenBy            User                @relation(fields: [givenById], references: [id])
  createdAt          DateTime            @default(now())
}

model AgentMemory {
  id        String          @id @default(cuid())
  agentId   String
  agent     AgentDefinition @relation(fields: [agentId], references: [id])
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  key       String
  value     String // JSON blob
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([agentId, tenantId, key])
}

model AgentConfig {
  id        String          @id @default(cuid())
  agentId   String
  agent     AgentDefinition @relation(fields: [agentId], references: [id])
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  enabled   Boolean         @default(true)
  config    String          @default("{}") // JSON blob: agent-specific settings
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([agentId, tenantId])
}

model AgentKnowledge {
  id          String           @id @default(cuid())
  agentId     String?
  agent       AgentDefinition? @relation(fields: [agentId], references: [id])
  scope       KnowledgeScope
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  region      String?
  category    String
  title       String
  content     String
  priority    Int              @default(0)
  active      Boolean          @default(true)
  source      KnowledgeSource  @default(MANUAL)
  createdById String?
  createdBy   User?            @relation("KnowledgeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([scope, category])
  @@index([tenantId])
}

// DEPRECATED in v2: maintenance-shaped join from the v1 framework.
// New agents capture the same information via AgentProposal.committedEntityType
// + committedEntityId. Drop one release after detector/triager migration to
// AgentProposal (step 3).
model TaskAgentInteraction {
  id              String          @id @default(cuid())
  taskId          String
  task            MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decisionId      String
  decision        AgentDecision   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  interactionType InteractionType
  createdAt       DateTime        @default(now())

  @@index([taskId, createdAt])
}

// ─── v2: AgentProposal (propose-not-publish) ────────────────
//
// Canonical record of an action an agent suggests. Domain tables are NOT
// written by agents directly; they're written by per-kind "committers" when
// a proposal is approved. See agent strategy plan §B/§C.
//
// Audience routing: exactly one of (tenantId, userId, federationId) is set
// to match audienceScope. targetTenantId may differ from tenantId — e.g. a
// USER-scope greenkeeper proposal reviewed by the user but acting on a
// specific club's data.
model AgentProposal {
  id      String          @id @default(cuid())
  agentId String
  agent   AgentDefinition @relation(fields: [agentId], references: [id])
  runId   String
  run     AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Free-text discriminator. Convention: <DOMAIN>_<NOUN>_<VERB>.
  // Examples: MAINTENANCE_TASK_CREATE, MAINTENANCE_TASK_PRIORITY,
  // CONTENT_DRAFT, AD_CREATIVE_DRAFT, CANCELLATION_RISK_REPORT,
  // GREENKEEPER_DAILY_PLAN, INVOICE_LINE_DRAFT.
  kind       String
  payload    String // JSON blob — domain payload the committer applies
  confidence Float
  reasoning  String

  // Audience — exactly one of (tenantId, userId, federationId) must be set
  // matching audienceScope. Enforced in code, not schema.
  audienceScope AgentProposalAudience
  tenantId      String?
  tenant        Tenant?               @relation(fields: [tenantId], references: [id])
  userId        String?
  // No FK on userId yet — federation/user audience routing TBD; document and add when stable.
  federationId  String? // No FK until federation models exist.

  // The tenant whose data the proposal acts on, when different from audience.
  // Null for proposals that don't mutate tenant data (e.g. info-only reports).
  targetTenantId String?

  status    AgentProposalStatus @default(PENDING)
  expiresAt DateTime?

  // Commit metadata — populated when status moves PENDING → APPROVED.
  committedAt          DateTime?
  committedById        String? // user who clicked approve (no FK yet to keep migration cheap)
  committedEntityType  String? // e.g. "MaintenanceTask"
  committedEntityId    String? // e.g. cuid of the created/updated row
  // Diff between proposed payload and committed payload (approve-with-edits).
  // Critical training-data signal — see strategy plan §L.4.
  committedPayloadDiff String?

  // Reject metadata — populated when status moves PENDING → REJECTED.
  rejectedAt   DateTime?
  rejectedById String?
  rejectReason String? // free-text; see strategy plan §L.4

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisions AgentDecision[]

  @@index([audienceScope, status, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([targetTenantId])
  @@index([agentId, kind, createdAt])
  @@index([runId])
}

// ─── v2: TenantAgentBudget (LLM cost capping) ───────────────
//
// Per-tenant monthly cap on LLM spend. When currentSpendCents exceeds
// monthlyCapCents, agent runs return RATE_LIMITED with reason=BUDGET.
// Reset by a scheduled job at month start. See strategy plan §E.6.
model TenantAgentBudget {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  monthlyCapCents   Int       @default(0) // 0 = uncapped
  currentSpendCents Int       @default(0)
  cappedUntil       DateTime?
  resetAt           DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AgentConfidenceMetrics {
  id                    String          @id @default(cuid())
  agentId               String
  agent                 AgentDefinition @relation(fields: [agentId], references: [id])
  tenantId              String
  tenant                Tenant          @relation(fields: [tenantId], references: [id])
  feedbackRate          Float           @default(0)
  positiveFeedbackRate  Float           @default(0)
  historyCompleteness   Float           @default(0)
  taskResolutionRate    Float           @default(0)
  averageResolutionDays Float?
  dataQualityScore      Float           @default(0)
  lastCalculatedAt      DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([agentId, tenantId])
}

model SentimentSnapshot {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  period        String // e.g. "2026-W18"
  overallScore  Float
  facilityScore Float
  messageCount  Int
  topComplaints String? // JSON array of category names
  trend         SentimentTrend @default(STABLE)
  createdAt     DateTime       @default(now())

  @@unique([tenantId, period])
}

// ─── Membership ──────────────────────────────────────────────

enum MembershipKind {
  MEMBER // ordinary club member who plays
  STAFF // employed by the club (admin, secretary, salaried staff)
  CONTRACTOR // external; services multiple clubs (e.g. professional greenkeeper)
  VOLUNTEER // unpaid helper, restricted permissions
}

enum MembershipStatus {
  PENDING // invited, not yet accepted
  ACTIVE
  SUSPENDED
  ENDED // membership has formally ended; row retained for history
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  role      Role             @default(USER)
  kind      MembershipKind   @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

// ─── Tenant Application (lead capture) ───────────────────────

enum ApplicationStatus {
  PENDING
  IN_REVIEW
  MORE_INFO_REQUESTED
  APPROVED
  REJECTED
}

model TenantApplication {
  id            String            @id @default(cuid())
  clubName      String
  contactName   String
  contactEmail  String
  contactPhone  String?
  country       String
  region        String?
  notes         String?
  status        ApplicationStatus @default(PENDING)
  decisionNotes String?
  reviewedAt    DateTime?
  reviewedById  String?
  // On approval, the created tenant is linked back here for traceability.
  tenantId      String?           @unique
  tenant        Tenant?           @relation(fields: [tenantId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([contactEmail])
}

// ─── User Invitation ─────────────────────────────────────────

enum InvitationStatus {
  QUEUED // issued during onboarding; not yet released. Outbound stub deferred until tenant goes live.
  PENDING // released and awaiting acceptance
  ACCEPTED
  EXPIRED
  REVOKED
}

model UserInvitation {
  id          String           @id @default(cuid())
  token       String           @unique @default(cuid())
  email       String
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  role        Role             @default(TENANT_ADMIN)
  kind        MembershipKind   @default(STAFF)
  invitedById String
  invitedBy   User             @relation("InvitationsSent", fields: [invitedById], references: [id])
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([tenantId, status])
}

// ─── Outbound Messaging (stub) ───────────────────────────────

enum OutboundChannel {
  EMAIL
  SMS
  SOCIAL_POST
}

enum OutboundStatus {
  STUBBED // captured locally; not delivered
  SENT_MANUAL // platform admin marked as sent out-of-band
  SENT // (future) delivered by real provider
  FAILED // (future) provider rejected
}

enum SocialPlatform {
  FACEBOOK
  TWITTER
  INSTAGRAM
}

model OutboundMessage {
  id              String          @id @default(cuid())
  channel         OutboundChannel
  status          OutboundStatus  @default(STUBBED)
  toAddress       String // email address, phone number, or platform handle
  subject         String? // email only
  bodyText        String
  bodyHtml        String? // email only
  template        String? // template name used
  templateData    String? // JSON of interpolated variables
  socialPlatform  SocialPlatform? // SOCIAL_POST only
  tenantId        String?
  tenant          Tenant?         @relation(fields: [tenantId], references: [id])
  // Optional link to the entity that triggered this message (e.g. a TenantApplication).
  relatedEntity   String?
  relatedEntityId String?
  createdAt       DateTime        @default(now())
  sentAt          DateTime? // when manually marked or actually delivered
  error           String?

  @@index([channel, createdAt])
  @@index([tenantId, createdAt])
  @@index([relatedEntity, relatedEntityId])
}

// ─── Onboarding Progress ─────────────────────────────────────

// Tracks a tenant's progression through the onboarding wizard. Each chapter
// writes through to its real domain model (no draft state) — this row only
// records which chapters have been completed and where to resume.
model OnboardingProgress {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  currentChapter         Int       @default(1) // 1..N
  completedChapters      String    @default("[]") // JSON array of chapter numbers (Int[] avoided to keep DB-portable)
  // Bumped each time we change chapter numbering so a one-shot, idempotent
  // shift can run on the next progress GET. Increments only when the
  // chapter-set itself changes shape, not for every code change. See
  // decisions log 2026-05-04 (chapter renumber strategy).
  schemaVersion          Int       @default(2) // v1 = 9 chapters; v2 = 10 chapters (added "organisation" at slot 2)
  subscriptionAttestedAt DateTime? // admin self-attested they'll pay (stub for real billing)
  completedAt            DateTime? // set when the admin presses 'Go live'
  lastAnswerAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// ─── Charity Accounts (UK/NI) ────────────────────────────────
//
// Opt-in module for clubs registered as charities under one of the UK/NI
// regulators. Gated at runtime by Tenant.country ∈ {GB, NI} AND the
// `charity` feature flag. See decisions log 2026-05-03 (country gate;
// CASC distinction; export-pack-only).
//
// MVP scope (this branch): manual ledger + R&P report + CSV export.
// Reserved for later phases:
//   - source enum has OCR / BANK_FEED slots for P3 (receipt OCR) + P4
//     (Open Banking stub). UI for those is not built yet.
//   - PDF / TAR wizard / GoCardless live integration are separate phases.

// Which regulator the tenant files with. Drives category seed + report
// template + portal deep-links.
enum CharityRegulator {
  CC_EW // Charity Commission for England & Wales
  OSCR // Office of the Scottish Charity Regulator
  CCNI // Charity Commission for Northern Ireland
}

// R&P category direction.
enum CharityCategoryKind {
  RECEIPT // money in
  PAYMENT // money out
}

// Fund accounting kind. Even Receipts & Payments accounts must split
// restricted income from unrestricted; modelled from v1 to avoid a
// painful retrofit later.
enum CharityFundKind {
  UNRESTRICTED // general charitable activities
  RESTRICTED // donor-specified purpose; cannot be re-purposed
  DESIGNATED // unrestricted but trustee-earmarked for a purpose
}

// Lifecycle of a financial year. LOCKED rejects further writes; unlock
// requires PLATFORM_ADMIN + audit. Set when TAR is finalised in P5
// (until then, year stays OPEN).
enum CharityFinancialYearStatus {
  OPEN
  LOCKED
}

// Where a transaction came from. Reserved values for later phases so
// they don't need a follow-up migration when P3/P4 land.
enum CharityTransactionSource {
  MANUAL // typed in by a tenant admin
  OCR // P3: extracted from a receipt photo (deferred)
  BANK_FEED // P4: imported from Open Banking (deferred)
}

// Asset/liability kinds for the Statement of Assets & Liabilities.
enum CharityAssetLiabilityKind {
  CASH_AT_BANK // bank balances at year-end
  INVESTMENT
  FIXED_ASSET // equipment, property
  DEBTOR // money owed to the charity
  CREDITOR // money the charity owes
  STOCK // bar/clubhouse stock at year-end
  OTHER_ASSET
  OTHER_LIABILITY
}

// One row per tenant. Holds the charity-identity fields that drive
// reports (number, regulator, year-end) and the narrative TAR fields
// that the trustee writes once and re-uses each year (reserves policy,
// public benefit statement).
model CharitySettings {
  id                     String           @id @default(cuid())
  tenantId               String           @unique
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charityNumber          String? // e.g. "1234567" (CC E&W) or "SC012345" (OSCR)
  regulator              CharityRegulator
  yearEndMonth           Int // 1..12 (e.g. 3 = March)
  yearEndDay             Int // 1..31
  reservesPolicy         String? // narrative for TAR re-use
  publicBenefitStatement String? // narrative for TAR re-use
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

// One per (tenant, accounting period). Closes via status=LOCKED once
// reports are signed off.
model CharityFinancialYear {
  id               String                     @id @default(cuid())
  tenantId         String
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startDate        String // ISO date "2026-04-01"
  endDate          String // ISO date "2027-03-31"
  status           CharityFinancialYearStatus @default(OPEN)
  bankBalanceAtEnd Int? // pence; manual entry for SoAL until P4 banking lands
  lockedAt         DateTime?
  lockedById       String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  transactions     CharityTransaction[]
  assetLiabilities CharityAssetLiability[]
  tars             CharityTAR[]

  @@unique([tenantId, startDate])
  @@index([tenantId, status])
}

// Chart of accounts. Seeded per regulator on first use of the module
// (see src/lib/charity/categories.ts). `code` matches the regulator's
// published R&P template (e.g. CC16 line numbers, OSCR R&P workpack
// rows, CCNI R&P toolkit rows). sortOrder controls report layout.
model CharityCategory {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String // regulator-template line code
  kind      CharityCategoryKind
  label     String
  sortOrder Int                 @default(0)
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  transactions CharityTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, kind, sortOrder])
}

// Tenant's funds. A "General" UNRESTRICTED fund is auto-created on
// charity-settings init so the ledger always has a default fund.
model CharityFund {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind      CharityFundKind @default(UNRESTRICTED)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactions CharityTransaction[]

  @@unique([tenantId, name])
  @@index([tenantId, kind])
}

// A single ledger entry. Amount stored as integer pence to dodge float
// rounding (mirrors BookingPayment.amount convention). Sign is implied
// by `kind` on the linked category — both receipts and payments are
// stored as positive amounts; the report flips signs as needed.
model CharityTransaction {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   CharityFinancialYear     @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  date            String // ISO date "2026-05-15"
  amount          Int // pence; always positive
  kind            CharityCategoryKind // RECEIPT or PAYMENT
  categoryId      String
  category        CharityCategory          @relation(fields: [categoryId], references: [id])
  fundId          String
  fund            CharityFund              @relation(fields: [fundId], references: [id])
  description     String
  reference       String? // cheque no, invoice ref, etc.
  source          CharityTransactionSource @default(MANUAL)
  sourceRef       String? // P3/P4: link to receipt/bank txn id
  createdById     String // User.id
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([tenantId, financialYearId, date])
  @@index([tenantId, categoryId])
  @@index([tenantId, fundId])
  @@index([source, sourceRef])
}

// Per-financial-year line items for the Statement of Assets &
// Liabilities. Bank balance is on the year row itself; this table
// covers everything else (fixed assets, debtors, creditors, stock).
model CharityAssetLiability {
  id              String                    @id @default(cuid())
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   CharityFinancialYear      @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  kind            CharityAssetLiabilityKind
  name            String
  amount          Int // pence; positive
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([tenantId, financialYearId])
}

// TAR lifecycle. DRAFT allows editing; FINALISED locks the year.
enum CharityTARStatus {
  DRAFT
  FINALISED
}

// One Trustees' Annual Report per (tenant, financial year). The
// `sections` column is a JSON blob keyed by regulator section slug
// (see src/lib/charity/tar-sections.ts) with shape:
//   { [slug]: { content, suggestedContent?, lastEditedAt?, source } }
// where source ∈ "manual" | "suggested" | "carried_forward".
model CharityTAR {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialYearId String
  financialYear   CharityFinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)
  status          CharityTARStatus   @default(DRAFT)
  sections        String             @default("{}") // JSON blob
  generatedAt     DateTime?          // last LLM suggestion run
  finalisedAt     DateTime?
  finalisedById   String?            // User.id who finalised
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, financialYearId])
  @@index([tenantId, status])
}
