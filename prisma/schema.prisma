generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-Tenant ────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  active      Boolean  @default(true)
  brandColor  String   @default("#16a34a")
  logoUrl     String?
  locale      String   @default("en")
  seasonStart String? // ISO date string e.g. "2026-04-01"
  seasonEnd   String?
  openingTime String   @default("08:00")
  closingTime String   @default("20:00")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  greens          Green[]
  bookings        Booking[]
  featureFlags    FeatureFlag[]
  tenantPayments  TenantPayment[]
  tasks           MaintenanceTask[]
  notifications   Notification[]
  auditEvents     AuditEvent[]
  contentSections ContentSection[]
  events          Event[]
  channels        Channel[]
  messages        Message[]
  trackingEvents  TrackingEvent[]
}

// ─── Auth & RBAC ─────────────────────────────────────────────

enum Role {
  GUEST
  USER
  MAINTENANCE
  TENANT_ADMIN
  PLATFORM_ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  suspended    Boolean  @default(false)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings            Booking[]
  bookingsCreated     Booking[]            @relation("BookingsCreatedBy")
  assignedTasks       MaintenanceTask[]    @relation("AssignedTo")
  submittedTasks      MaintenanceTask[]    @relation("SubmittedBy")
  taskNotes           TaskNote[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  createdSections     ContentSection[]     @relation("CreatedBy")
  updatedSections     ContentSection[]     @relation("UpdatedBy")
  createdEvents       Event[]              @relation("EventCreatedBy")
  updatedEvents       Event[]              @relation("EventUpdatedBy")
  channelMemberships  ChannelMember[]
  messages            Message[]
  createdChannels     Channel[]            @relation("ChannelCreatedBy")
  trackingEvents      TrackingEvent[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Feature Flags ───────────────────────────────────────────

model FeatureFlag {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  key      String
  enabled  Boolean @default(false)

  @@unique([tenantId, key])
}

// ─── Greens & Rinks ─────────────────────────────────────────

model Green {
  id       String @id @default(cuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  rinks    Rink[]
}

model Rink {
  id      String @id @default(cuid())
  name    String
  greenId String
  green   Green  @relation(fields: [greenId], references: [id])

  bookingSlots BookingSlot[]
}

// ─── Booking ─────────────────────────────────────────────────

enum BookingStatus {
  REQUESTED
  APPROVED
  RESERVED
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  bookedByUserId String?
  bookedByUser   User?         @relation("BookingsCreatedBy", fields: [bookedByUserId], references: [id])
  date           String // ISO date "2026-05-10"
  status         BookingStatus @default(REQUESTED)
  adminOverride  Boolean       @default(false)
  overrideReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  slots           BookingSlot[]
  waitlistEntries WaitlistEntry[]
  payment         BookingPayment?

  @@index([bookedByUserId])
}

model BookingSlot {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id])
  rinkId     String
  rink       Rink    @relation(fields: [rinkId], references: [id])
  timeSlot   String // e.g. "10:00-12:00"
  playerName String?
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

// ─── Payments ────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model BookingPayment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  amount      Int // in pence/cents
  currency    String        @default("GBP")
  status      PaymentStatus @default(PENDING)
  checkoutUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TenantPayment {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  amount     Int
  currency   String        @default("GBP")
  status     PaymentStatus @default(PENDING)
  invoiceRef String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ─── Maintenance ─────────────────────────────────────────────

enum TaskCategory {
  GENERAL
  RINK_SURFACE
  EQUIPMENT
  FACILITIES
  SAFETY
  GROUNDS
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  CLOSED
  REOPENED
}

model MaintenanceTask {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  title         String
  description   String
  category      TaskCategory @default(GENERAL)
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(SUBMITTED)
  submittedById String
  submittedBy   User         @relation("SubmittedBy", fields: [submittedById], references: [id])
  assignedToId  String?
  assignedTo    User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  notes TaskNote[]
}

model TaskNote {
  id        String          @id @default(cuid())
  taskId    String
  task      MaintenanceTask @relation(fields: [taskId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime        @default(now())
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // e.g. "WAITLIST_AVAILABLE", "TASK_ASSIGNED", "BOOKING_APPROVED"
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Audit Trail ─────────────────────────────────────────────

model AuditEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  actorRole Role
  action    String // dot-notation e.g. "booking.created"
  entity    String // model name e.g. "Booking"
  entityId  String?
  piiAccess Boolean  @default(false)
  meta      String? // JSON string for flexible payload

  @@index([tenantId, timestamp])
  @@index([actorId, timestamp])
  @@index([entity, entityId])
}

// ─── Content Management ──────────────────────────────────────

enum SectionType {
  HERO
  ABOUT
  PHOTO
  MAP
  CONTACT
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model ContentSection {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  type        SectionType
  status      ContentStatus @default(DRAFT)
  enabled     Boolean       @default(true)
  order       Int           @default(0)
  title       String
  content     String // JSON blob — shape varies by section type
  createdById String
  createdBy   User          @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?         @relation("UpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, status])
}

// ─── Events ──────────────────────────────────────────────────

enum EventCategory {
  SOCIAL
  COMPETITION
  LEAGUE
  OPEN_DAY
  TOURNAMENT
  OTHER
}

enum EventFormat {
  KNOCKOUT
  AMERICAN
  LEAGUE_FORMAT
  CANADIAN
  OTHER_FORMAT
}

enum PlayerCount {
  SINGLES
  PAIRS
  TRIPLES
  FOURS
}

enum EventVisibility {
  MEMBERS_ONLY
  PUBLIC
}

model Event {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  title        String
  description  String
  category     EventCategory   @default(SOCIAL)
  format       EventFormat?
  playerCount  PlayerCount?
  date         String // ISO date "2026-06-15"
  startTime    String // "HH:mm"
  endTime      String?
  location     String?
  capacity     Int?
  entryFee     Int? // in pence
  currency     String          @default("GBP")
  imageUrl     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  visibility   EventVisibility @default(MEMBERS_ONLY)
  status       String          @default("DRAFT") // DRAFT | PUBLISHED
  createdById  String
  createdBy    User            @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?           @relation("EventUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([visibility, status])
}

// ─── Messaging ───────────────────────────────────────────────

enum ChannelType {
  PUBLIC
  PRIVATE
  GROUP
  DIRECT
}

enum ChannelMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Channel {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  type        ChannelType @default(PUBLIC)
  createdById String
  createdBy   User        @relation("ChannelCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members     ChannelMember[]
  messages    Message[]
  readCursors MessageReadCursor[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
}

model ChannelMember {
  id         String            @id @default(cuid())
  channelId  String
  channel    Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  role       ChannelMemberRole @default(MEMBER)
  mutedUntil DateTime?
  joinedAt   DateTime          @default(now())

  @@unique([channelId, userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String
  pinned    Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([channelId, createdAt])
  @@index([tenantId, createdAt])
}

model MessageReadCursor {
  id                String   @id @default(cuid())
  channelId         String
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId            String
  lastReadMessageId String
  updatedAt         DateTime @updatedAt

  @@unique([channelId, userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Feature Tracking (Observability) ────────────────────────

enum TrackingEventType {
  PAGE_VIEW
  FEATURE_USE
  INTERACTION
  SESSION_START
}

model TrackingEvent {
  id                 String            @id @default(cuid())
  timestamp          DateTime          @default(now())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id])
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])
  sessionFingerprint String
  eventType          TrackingEventType
  path               String
  action             String?
  entity             String?
  entityId           String?
  browserFamily      String
  browserVersion     String?
  osFamily           String
  deviceType         String
  isPWA              Boolean           @default(false)
  meta               String?

  @@index([tenantId, timestamp])
  @@index([eventType, timestamp])
  @@index([path, timestamp])
  @@index([sessionFingerprint])
}
